# Written by `tero init`. A user unit for tero-agent's systemd user manager:
# rootless Podman needs the setuid id-mapping helpers, which a system
# service's sandbox blocks. Every systemd sandbox option either blocks those
# helpers or Podman's namespaces in a user manager, so the boundary is the
# tero-agent user.
[Unit]
Description=Tero agent (builds and runs apps)
Documentation=https://github.com/leanhanc/tero
ConditionUser=tero-agent
# `tero assume-breach` holds the agent back with this file until it has run
# to the end.
ConditionPathExists=!/etc/tero/reset-in-progress

[Service]
ExecStart=/usr/local/bin/tero agent
Restart=on-failure
RestartSec=2s
UMask=0077

[Install]
WantedBy=default.target
