# Written by `tero init`. The key service holds the master key, the admin's
# credentials and passkeys, the dashboard's sessions and the security log. It
# runs as its own user with no network, so nothing running as tero can read
# them or create a session. It reads the dashboard domain, which passkeys are
# bound to, from /etc/tero/config.json. Started by tero-keys.socket.
[Unit]
Description=Tero key service
Documentation=https://github.com/leanhanc/tero
Requires=tero-keys.socket
After=tero-keys.socket

[Service]
User=tero-keys
Group=tero-keys
ExecStart=/usr/local/bin/tero keys
Restart=on-failure
RestartSec=2s

# systemd decrypts every file, each named by its version, as root and hands
# it over in $CREDENTIALS_DIRECTORY as kek_<version>. A file that won't
# decrypt stops the start; the dashboard and apps keep running, and
# `sudo tero reset-login` recovers.
LoadCredentialEncrypted=kek:/etc/tero/keys/

StateDirectory=tero-keys
StateDirectoryMode=0700
UMask=0077

# Two Argon2id hashes of 64 MiB at a time, plus SQLite. Go's garbage
# collector lets the heap grow to twice what is in use before collecting, so
# GOMEMLIMIT makes it collect before the next hashes reach MemoryMax.
MemoryMax=256M
Environment=GOMEMLIMIT=200MiB
TasksMax=64
LimitCORE=0

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# No ProtectProc= or PrivateUsers=: the key service reads its callers' cgroups
# and uids from /proc.
