# Written by `tero init`.
[Unit]
Description=Tero host firewall
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/tero/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/tero/firewall.nft
# No ExecStop: stopping the unit must not open the host. Remove the rules
# with `nft delete table inet tero` on purpose instead.

[Install]
WantedBy=sysinit.target
