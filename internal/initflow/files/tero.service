# Written by `tero init`.
[Unit]
Description=Tero
Documentation=https://github.com/leanhanc/tero
After=network-online.target tero-firewall.service tero-keys.socket
# Logins are checked by the key service. Only wanted, not required: when it
# restarts or fails to start, the dashboard and apps keep serving and logins
# fail closed.
Wants=network-online.target tero-keys.socket
# The dashboard only starts behind the firewall.
Requires=tero-firewall.service

[Service]
User=tero
Group=tero
ExecStart=/usr/local/bin/tero serve
Restart=on-failure
RestartSec=2s

# Caddy binds 80 and 443; this is the only capability the service gets.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

StateDirectory=tero
StateDirectoryMode=0750
# tero's home is the state directory. Podman's storage and configuration and
# tero's user units live under it and belong to the agent, so the service
# can't plant anything the agent would run.
InaccessiblePaths=/var/lib/tero/.config /var/lib/tero/.local /var/lib/tero/.cache
Environment=XDG_DATA_HOME=/var/lib/tero/data XDG_CONFIG_HOME=/var/lib/tero/config
UMask=0077

# A flood of log lines can't make journald rotate out older entries, such as
# the key service's copy of the security log.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

# Bounds the service alone, so a flood of requests can't push the kernel's OOM
# killer onto sshd or the apps.
MemoryHigh=384M
MemoryMax=512M

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
