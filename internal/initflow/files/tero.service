# Written by `tero init`.
[Unit]
Description=Tero
Documentation=https://github.com/leanhanc/tero
After=network-online.target tero-firewall.service
Wants=network-online.target
# The dashboard only starts behind the firewall.
Requires=tero-firewall.service

[Service]
User=tero
Group=tero
ExecStart=/usr/local/bin/tero serve
Restart=on-failure
RestartSec=2s

# Caddy binds 80 and 443; this is the only capability the service gets.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

StateDirectory=tero
StateDirectoryMode=0750
Environment=XDG_DATA_HOME=/var/lib/tero/data XDG_CONFIG_HOME=/var/lib/tero/config
UMask=0077

# Bounds the service alone, so a flood of requests can't push the kernel's OOM
# killer onto sshd or the apps.
MemoryHigh=384M
MemoryMax=512M

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
